    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.9.1",
    "react-native-purchases-store-galaxy": "^10.9.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android",
    "verify": "npm run typecheck && npm test && npm run export:web",
    "check:release": "node scripts/check-release.mjs",
    "eas-build-post-install": "node scripts/check-release.mjs --if-production",
    "format": "prettier --write App.tsx src tests *.ts",
    "format:check": "prettier --check App.tsx src tests *.ts"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
