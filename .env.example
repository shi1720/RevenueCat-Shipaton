# Optional. Blank values keep Unpause usable locally, with no simulated login/purchases.
# Copy to .env.local (gitignored), then restart Metro / rebuild your bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public app-specific SDK keys only. NEVER place secret/service-role keys here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_GALAXY_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
EXPO_PUBLIC_ANDROID_STORE=google

# Server-only secrets belong in Supabase Edge Function secrets, never EXPO_PUBLIC_*:
# REVENUECAT_ENABLED=true  (required with billing; gates complete provider deletion)
# REVENUECAT_SECRET_KEY=<RevenueCat secret API v1 key with customer deletion access>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are automatically available in hosted functions.

# Public owner-controlled pages used by the production release gate
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
# EAS values come from your own Expo project (not required for local builds)
EAS_PROJECT_ID=
EXPO_OWNER=
